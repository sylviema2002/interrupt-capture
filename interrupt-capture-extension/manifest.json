{
  "manifest_version": 3,
  "name": "中断快记",
  "version": "0.7.1",
  "description": "一键记录当前浏览器标签页的中断事项，并按自定义时间循环提醒。",
  "permissions": ["activeTab", "alarms", "storage", "tabs", "windows", "system.display"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "action": {
    "default_title": "中断快记",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
